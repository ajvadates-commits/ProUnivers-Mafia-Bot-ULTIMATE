# ===== BOT =====
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OWNER_ID=YOUR_TELEGRAM_ID
OWNER_USERNAME=@your_username
ADMIN_IDS=123456789

# ===== DATABASE (Neon PostgreSQL tavsiya) =====
# Neon.tech dan connection string oling va qoying
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Yoki local SQLite:
DATABASE_PATH=./data/mafia.sqlite

# ===== GAME =====
DEFAULT_LANGUAGE=uz
MIN_PLAYERS=5
MAX_PLAYERS=20

# ===== ECONOMY =====
MONEY_PRICE=10
DIAMOND_PRICE=50
COIN_PRICE=100
CLONE_PRICE_STARS=100
CLONE_TOKEN_SECRET=change-this-to-a-long-random-secret

# ===== SECURITY =====
REQUIRE_BOT_ADMIN_RIGHTS=true
REQUIRE_ALL_ADMIN_RIGHTS=true

# ===== ADMIN / MODERATION =====
LOG_LEVEL=info
MAINTENANCE=false

# ===== SERVER =====
PORT=10000
NODE_ENV=production
